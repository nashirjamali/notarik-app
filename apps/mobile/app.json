{
  "expo": {
    "name": "Notarik",
    "slug": "notarik",
    "scheme": "notarik",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Notarik uses the camera to scan your receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Notarik reads receipt photos you choose from your library."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {}
  }
}
